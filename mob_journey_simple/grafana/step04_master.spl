index=summary_mob_journey step="04"
| dedup order_key
| eval order_type = "All Order Types"
| stats
    count                                            AS total_orders,
    sum(eval(if(decision="Accept",      1, 0)))      AS accepted_orders,
    sum(eval(if(decision="Decline",     1, 0)))      AS declined_orders,
    sum(eval(if(decision="Investigate", 1, 0)))      AS failure_count,
    avg(latency_sec)                                 AS avg_latency_sec,
    perc10(latency_sec)                              AS p10_latency_sec,
    perc50(latency_sec)                              AS p50_latency_sec,
    perc90(latency_sec)                              AS p90_latency_sec,
    perc95(latency_sec)                              AS p95_latency_sec,
    perc99(latency_sec)                              AS p99_latency_sec,
    max(latency_sec)                                 AS max_latency_sec
    BY order_type
| eval within_slo      = accepted_orders + declined_orders
| eval avg_latency_sec = round(avg_latency_sec, 2)
| eval p10_latency_sec = round(p10_latency_sec, 2)
| eval p50_latency_sec = round(p50_latency_sec, 2)
| eval p90_latency_sec = round(p90_latency_sec, 2)
| eval p95_latency_sec = round(p95_latency_sec, 2)
| eval p99_latency_sec = round(p99_latency_sec, 2)
| eval max_latency_sec = round(max_latency_sec, 2)
| eval slo_percentage  = if(total_orders>0, round(within_slo/total_orders*100, 2), null())
| eval slo_target      = "98.0%"
| eval slo_status      = case(slo_percentage >= 98, "✅ MET", slo_percentage >= 97.5, "⚠ AT RISK", true(), "❌ BREACHED")
| eval is_selected = if(order_type="$order_type", 1, 0)
| eval Step04     = if(is_selected=1, slo_percentage,  null())
| eval Step04_P10 = if(is_selected=1, p10_latency_sec, null())
| eval Step04_P50 = if(is_selected=1, p50_latency_sec, null())
| eval Step04_P90 = if(is_selected=1, p90_latency_sec, null())
| eval Step04_P95 = if(is_selected=1, p95_latency_sec, null())
| eval Step04_P99 = if(is_selected=1, p99_latency_sec, null())
| sort is_selected, order_type
| appendpipe [ | stats sum(is_selected) AS matched | where matched=0 | eval order_type="Not applicable", Step04=-1 | fields order_type Step04 ]
| fields - is_selected matched
