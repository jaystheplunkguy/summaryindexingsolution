index=summary_mob_journey step="01"
| dedup order_key
| appendpipe [ | eval order_type = "All Order Types" ]
| stats
    sum(isValid) AS total_orders,
    sum(isGood)  AS within_slo
    BY order_type
| eval failure_count   = total_orders - within_slo
| eval slo_percentage  = if(total_orders>0, round(within_slo/total_orders*100, 2), null())
| eval slo_target      = "No formal SLO"
| eval slo_status      = "N/A"
| eval is_selected = if(order_type="$order_type", 1, 0)
| eval Step01 = if(is_selected=1, slo_percentage, null())
| sort is_selected, order_type
| appendpipe [ | stats sum(is_selected) AS matched | where matched=0 | eval order_type="Not applicable", Step01=-1 | fields order_type Step01 ]
| fields - is_selected matched
