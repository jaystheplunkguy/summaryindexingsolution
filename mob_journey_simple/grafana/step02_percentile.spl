index=summary_mob_journey step="02"
| dedup order_key
| appendpipe [ | eval order_type = "All Order Types" ]
| bin _time span=30m
| stats
    sum(is_valid) AS total_orders,
    sum(is_good)  AS within_slo
    BY _time order_type
| where order_type="$order_type"
| eval Step02 = if(total_orders>0, round(within_slo/total_orders*100, 2), null()),
       Step02_Orders = total_orders
| fields _time Step02 Step02_Orders
