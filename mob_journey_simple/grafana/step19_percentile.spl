index=summary_mob_journey step="19"
| dedup order_key sortby -written_at
| appendpipe [ | eval order_type = "All Order Types" ]
| eval _time = coalesce(t_callback, t_sent)
| where isnotnull(_time)
| bin _time span=30m
| stats
    count                                            AS total_orders,
    sum(order_good)                                  AS within_slo,
    perc10(latency_sec)                              AS p10_seconds,
    perc50(latency_sec)                              AS p50_seconds,
    perc90(latency_sec)                              AS p90_seconds,
    perc95(latency_sec)                              AS p95_seconds,
    perc99(latency_sec)                              AS p99_seconds
    BY _time order_type
| where order_type="$order_type"
| eval Step19 = if(total_orders>0, round(within_slo/total_orders*100, 2), null()),
       Step19_P10 = round(p10_seconds*1000, 2),
       Step19_P50 = round(p50_seconds*1000, 2),
       Step19_P90 = round(p90_seconds*1000, 2),
       Step19_P95 = round(p95_seconds*1000, 2),
       Step19_P99 = round(p99_seconds*1000, 2)
| fields _time Step19 Step19_P10 Step19_P50 Step19_P90 Step19_P95 Step19_P99
