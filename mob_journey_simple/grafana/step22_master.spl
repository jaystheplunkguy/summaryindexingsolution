index=summary_mob_journey step="22"
| dedup order_key
| appendpipe [ | eval order_type = "All Order Types" ]
| eval latency_sec = call_network_epoch - validate_sim_epoch
| eval sli_met = if(latency_sec>=0 AND latency_sec<=60, 1, 0)
| stats
    count                                            AS total_orders,
    sum(sli_met)                                     AS within_slo,
    sum(eval(if(sli_met=0, 1, 0)))                   AS failure_count,
    avg(latency_sec)                                 AS avg_latency_sec,
    perc10(latency_sec)                              AS p10_latency_sec,
    perc50(latency_sec)                              AS p50_latency_sec,
    perc90(latency_sec)                              AS p90_latency_sec,
    perc95(latency_sec)                              AS p95_latency_sec,
    perc99(latency_sec)                              AS p99_latency_sec,
    max(latency_sec)                                 AS max_latency_sec
    BY order_type
| eval avg_latency_sec = round(avg_latency_sec, 2)
| eval p10_latency_sec = round(p10_latency_sec, 2)
| eval p50_latency_sec = round(p50_latency_sec, 2)
| eval p90_latency_sec = round(p90_latency_sec, 2)
| eval p95_latency_sec = round(p95_latency_sec, 2)
| eval p99_latency_sec = round(p99_latency_sec, 2)
| eval max_latency_sec = round(max_latency_sec, 2)
| eval slo_percentage = if(total_orders>0, round(within_slo/total_orders*100, 2), null())
| eval slo_target = "99.5%"
| eval slo_status = if(slo_percentage >= 99.5, "✅ MET", "❌ BREACHED")
| eval is_selected = if(order_type="$order_type", 1, 0)
| eval Step22     = if(is_selected=1, slo_percentage,  null())
| eval Step22_P10 = if(is_selected=1, p10_latency_sec, null())
| eval Step22_P50 = if(is_selected=1, p50_latency_sec, null())
| eval Step22_P90 = if(is_selected=1, p90_latency_sec, null())
| eval Step22_P95 = if(is_selected=1, p95_latency_sec, null())
| eval Step22_P99 = if(is_selected=1, p99_latency_sec, null())
| sort is_selected, order_type
| appendpipe [ | stats sum(is_selected) AS matched | where matched=0 | eval order_type="Not applicable", Step22=-1 | fields order_type Step22 ]
| fields - is_selected matched
