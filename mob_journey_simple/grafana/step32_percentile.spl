index=summary_mob_journey step="32"
| dedup order_key
| appendpipe
    [
      | eval Order_Type="All Order Types"
    ]
| where start_epoch <= relative_time(now(), "-30m")
| eval _time = coalesce(complete_epoch,start_epoch)
| where isnotnull(_time)
| bin _time span=30m
| stats
    count as total_orders
    sum(slo_met) as within_slo
    perc10(latency_seconds) as p10_seconds
    perc50(latency_seconds) as p50_seconds
    perc90(latency_seconds) as p90_seconds
    perc95(latency_seconds) as p95_seconds
    perc99(latency_seconds) as p99_seconds
    by _time Order_Type
| rename Order_Type as order_type
| eval Step32=if(total_orders>0,round(within_slo/total_orders*100,2),null()),
       Step32_P10=round(p10_seconds*1000,2),
       Step32_P50=round(p50_seconds*1000,2),
       Step32_P90=round(p90_seconds*1000,2),
       Step32_P95=round(p95_seconds*1000,2),
       Step32_P99=round(p99_seconds*1000,2)
| fields _time order_type Step32 Step32_P10 Step32_P50 Step32_P90 Step32_P95 Step32_P99
