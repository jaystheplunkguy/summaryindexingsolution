index=summary_mob_journey step="09"
| dedup order_key sortby -written_at
| eval order_type="All Order Types"
| eval _time=coalesce(wtc_submit_evt_time, received_evt_time)
| where isnotnull(_time)
| bin _time span=30m
| stats
    count               as total_orders
    sum(slo_met)        as within_slo
    perc10(latency_sec) as p10_seconds
    perc50(latency_sec) as p50_seconds
    perc90(latency_sec) as p90_seconds
    perc95(latency_sec) as p95_seconds
    perc99(latency_sec) as p99_seconds
    by _time order_type
| where order_type="$order_type"
| eval Step09 = if(total_orders>0, round(within_slo/total_orders*100, 2), null()),
       Step09_P10 = round(p10_seconds*1000, 2),
       Step09_P50 = round(p50_seconds*1000, 2),
       Step09_P90 = round(p90_seconds*1000, 2),
       Step09_P95 = round(p95_seconds*1000, 2),
       Step09_P99 = round(p99_seconds*1000, 2)
| append [ | makeresults | eval _time=now(), Step09=-1 | where "$order_type"!="All Order Types" ]
| fields _time Step09 Step09_P10 Step09_P50 Step09_P90 Step09_P95 Step09_P99
