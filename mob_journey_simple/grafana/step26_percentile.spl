index=summary_mob_journey step="26"
| dedup order_key
| eval order_type = if(activity_type="Disconnect", mvappend("Disconnect", "Port-Out"), activity_type)
| eval order_type = mvappend(order_type, "All Order Types")
| mvexpand order_type
| where t_attempted <= relative_time(now(), "-30m")
| eval _time = coalesce(t_delivered, t_attempted)
| where isnotnull(_time)
| bin _time span=30m
| stats
    count                       AS total_orders,
    sum(notification_delivered) AS within_slo,
    perc10(latency_sec)         AS p10_seconds,
    perc50(latency_sec)         AS p50_seconds,
    perc90(latency_sec)         AS p90_seconds,
    perc95(latency_sec)         AS p95_seconds,
    perc99(latency_sec)         AS p99_seconds
    BY _time order_type
| where order_type="$order_type"
| eval Step26 = if(total_orders>0, round(within_slo/total_orders*100, 2), null()),
       Step26_P10 = round(p10_seconds*1000, 2),
       Step26_P50 = round(p50_seconds*1000, 2),
       Step26_P90 = round(p90_seconds*1000, 2),
       Step26_P95 = round(p95_seconds*1000, 2),
       Step26_P99 = round(p99_seconds*1000, 2)
| fields _time Step26 Step26_P10 Step26_P50 Step26_P90 Step26_P95 Step26_P99
