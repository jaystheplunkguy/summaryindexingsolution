index=summary_mob_journey step="34"
| dedup order_key sortby -written_at
| appendpipe [ | eval order_type = "All Order Types" ]
| where order_type="$order_type"
| eval _time=coalesce(end_time,start_time)
| where isnotnull(_time)
| bin _time span=30m
| stats count AS total_orders,sum(eval(if(final_outcome="Success",1,0))) AS within_slo,perc10(latency_sec) AS p10_seconds,perc50(latency_sec) AS p50_seconds,perc90(latency_sec) AS p90_seconds,perc95(latency_sec) AS p95_seconds,perc99(latency_sec) AS p99_seconds BY _time
| eval Step34=if(total_orders>0,round(within_slo/total_orders*100,2),null()),Step34_P10=round(p10_seconds*1000,2),Step34_P50=round(p50_seconds*1000,2),Step34_P90=round(p90_seconds*1000,2),Step34_P95=round(p95_seconds*1000,2),Step34_P99=round(p99_seconds*1000,2)
| append [ | makeresults | eval _time=now(), Step34=-1 | where "$order_type"="Modify" OR "$order_type"="Disconnect" OR "$order_type"="Port-Out" ]
| fields _time Step34 Step34_P10 Step34_P50 Step34_P90 Step34_P95 Step34_P99
