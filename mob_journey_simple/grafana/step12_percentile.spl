index=summary_mob_journey step="12"
| dedup order_key
| appendpipe [ | eval order_type = "All Order Types" ]
| eval _time = coalesce(t_processing, t_received)
| where isnotnull(_time)
| bin _time span=30m
| stats
    count                                            AS total_orders,
    sum(order_good)                                  AS within_slo,
    perc10(latency_sec)                              AS p10_seconds,
    perc50(latency_sec)                              AS p50_seconds,
    perc90(latency_sec)                              AS p90_seconds,
    perc95(latency_sec)                              AS p95_seconds,
    perc99(latency_sec)                              AS p99_seconds
    BY _time order_type
| where order_type="$order_type"
| eval Step12 = if(total_orders>0, round(within_slo/total_orders*100, 2), null()),
       Step12_P10 = round(p10_seconds*1000, 2),
       Step12_P50 = round(p50_seconds*1000, 2),
       Step12_P90 = round(p90_seconds*1000, 2),
       Step12_P95 = round(p95_seconds*1000, 2),
       Step12_P99 = round(p99_seconds*1000, 2)
| fields _time Step12 Step12_P10 Step12_P50 Step12_P90 Step12_P95 Step12_P99
