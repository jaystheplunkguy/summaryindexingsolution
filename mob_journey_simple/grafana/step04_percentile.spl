index=summary_mob_journey step="04"
| dedup order_key
| eval order_type = "All Order Types"
| eval _time = t_decision
| where isnotnull(_time)
| bin _time span=30m
| stats
    count                                            AS total_orders,
    sum(eval(if(decision="Accept",  1, 0)))          AS accepted_orders,
    sum(eval(if(decision="Decline", 1, 0)))          AS declined_orders,
    perc10(latency_sec)                              AS p10_seconds,
    perc50(latency_sec)                              AS p50_seconds,
    perc90(latency_sec)                              AS p90_seconds,
    perc95(latency_sec)                              AS p95_seconds,
    perc99(latency_sec)                              AS p99_seconds
    BY _time order_type
| eval within_slo = accepted_orders + declined_orders
| where order_type="$order_type"
| eval Step04 = if(total_orders>0, round(within_slo/total_orders*100, 2), null()),
       Step04_P10 = round(p10_seconds*1000, 2),
       Step04_P50 = round(p50_seconds*1000, 2),
       Step04_P90 = round(p90_seconds*1000, 2),
       Step04_P95 = round(p95_seconds*1000, 2),
       Step04_P99 = round(p99_seconds*1000, 2)
| append [ | makeresults | eval _time=now(), Step04=-1 | where "$order_type"!="All Order Types" ]
| fields _time Step04 Step04_P10 Step04_P50 Step04_P90 Step04_P95 Step04_P99
