index=summary_mob_journey step="22"
| dedup order_key
| appendpipe [ | eval order_type = "All Order Types" ]
| eval latency_sec = call_network_epoch - validate_sim_epoch
| eval sli_met = if(latency_sec>=0 AND latency_sec<=60, 1, 0)
| eval _time = call_network_epoch
| where isnotnull(_time)
| bin _time span=30m
| stats
    count                                            AS total_orders,
    sum(sli_met)                                     AS within_slo,
    perc10(latency_sec)                              AS p10_seconds,
    perc50(latency_sec)                              AS p50_seconds,
    perc90(latency_sec)                              AS p90_seconds,
    perc95(latency_sec)                              AS p95_seconds,
    perc99(latency_sec)                              AS p99_seconds
    BY _time order_type
| where order_type="$order_type"
| eval Step22 = if(total_orders>0, round(within_slo/total_orders*100, 2), null()),
       Step22_P10 = round(p10_seconds*1000, 2),
       Step22_P50 = round(p50_seconds*1000, 2),
       Step22_P90 = round(p90_seconds*1000, 2),
       Step22_P95 = round(p95_seconds*1000, 2),
       Step22_P99 = round(p99_seconds*1000, 2)
| append [ | makeresults | eval _time=now(), Step22=-1 | where "$order_type"="Disconnect" OR "$order_type"="Port-Out" ]
| fields _time Step22 Step22_P10 Step22_P50 Step22_P90 Step22_P95 Step22_P99
